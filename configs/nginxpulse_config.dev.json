{
  "websites": [
    {
      "name": "GZ Log Test",
      "logPath": "/home/joyce/workspace/nginx_log/*.log",
      "domains": [
        "localhost"
      ],
      "logType": "nginx",
      "logFormat": "",
      "logRegex": "",
      "timeLayout": "",
      "autoDiscoverHosts": false
    }
  ],
  "pvFilter": {
    "statusCodeInclude": [200, 201, 204, 301, 302, 304],
    "excludePatterns": [],
    "excludeIPs": []
  },
  "system": {
    "logDestination": "file",
    "taskInterval": "5s",
    "logRetentionDays": 30,
    "parseBatchSize": 100,
    "ipGeoCacheLimit": 1000000,
    "ipGeoApiUrl": "http://ip-api.com/batch",
    "demoMode": false,
    "accessKeys": [],
    "language": "zh-CN",
    "mobilePwaEnabled": true
  },
  "database": {
    "driver": "postgres",
    "dsn": "postgres://nginxpulse:nginxpulse@127.0.0.1:5432/nginxpulse?sslmode=disable"
  },
  "server": {
    "Port": ":8089"
  }
}